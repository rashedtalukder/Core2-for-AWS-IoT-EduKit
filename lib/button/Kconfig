menu "Virtual touch buttons"
    depends on SOFTWARE_DISPLAY_SUPPORT && SOFTWARE_BUTTON_SUPPORT

    config CORE2FORAWS_BUTTON_DEBOUNCE_MS
        int "Virtual button debounce time (ms)"
        default 30
        range 0 200
        help
        Minimum time that a press or release state must remain stable before
        the virtual button driver accepts the transition.
endmenu
